<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_glass_dialog">

    <!-- Title Text -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Input Field (Explicit 0dp start padding so text aligns exactly with title above) -->
    <EditText
        android:id="@+id/dialogInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:fontFamily="sans-serif-medium"
        android:textSize="16sp"
        android:inputType="text" />

    <!-- Button Row with Pill-Shaped Ripple Highlights -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNegative"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="CANCEL"
            android:textColor="?android:attr/textColorSecondary"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_ripple"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnPositive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="SAVE"
            android:textColor="?android:attr/textColorPrimary"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_ripple"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>