<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.github.chrisbanes.photoview.PhotoView
        android:id="@+id/zoomImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom Center Exit Button (Matching Dock height 56dp and bottom margin 16dp) -->
    <ImageButton
        android:id="@+id/btnCloseZoom"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_circle"
        android:src="@drawable/ic_exit_fullscreen"
        android:contentDescription="Exit View"
        app:tint="?android:attr/textColorPrimary" />
</RelativeLayout>