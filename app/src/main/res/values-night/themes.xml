<resources>
    <style name="Theme.EssentialSpace" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Google Material 3 Dark Surface Colors -->
        <item name="android:colorBackground">@color/m3_dark_background</item>
        <item name="colorSurface">@color/m3_dark_surface</item>
        <item name="colorSurfaceVariant">@color/m3_dark_surface_container</item>
        <item name="colorSecondaryContainer">@color/m3_dark_surface_container_high</item>
        <item name="android:windowBackground">@color/m3_dark_background</item>

        <!-- Google Material 3 Dark Text Colors -->
        <item name="android:textColorPrimary">@color/m3_dark_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_dark_on_surface_variant</item>
        <item name="android:textColorTertiary">@android:color/transparent</item>

        <item name="elevationOverlayEnabled">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Frosted Glass Theme (Night Override) -->
    <style name="Theme.EssentialSpace.Glass" parent="Theme.EssentialSpace">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorBackground">#99000000</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="colorSurface">#D1161920</item>
        <item name="colorSurfaceVariant">#E012141A</item>
        <item name="colorSecondaryContainer">#E620242E</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E6E6E6</item>
        <item name="android:textColorTertiary">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>