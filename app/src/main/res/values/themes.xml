<resources>
    <!-- Base App Theme (Material 3 DayNight) -->
    <style name="Theme.EssentialSpace" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Google Material 3 Light Colors -->
        <item name="android:colorBackground">@color/m3_light_background</item>
        <item name="colorSurface">@color/m3_light_surface</item>
        <item name="colorSurfaceVariant">@color/m3_light_surface_container</item>
        <item name="colorSecondaryContainer">@color/m3_light_surface_container_high</item>
        <item name="android:windowBackground">@color/m3_light_background</item>

        <!-- Google Material 3 Light Text Colors -->
        <item name="android:textColorPrimary">@color/m3_light_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_light_on_surface_variant</item>
        <item name="android:textColorTertiary">@android:color/transparent</item>

        <item name="elevationOverlayEnabled">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Pitch Black Theme (AMOLED Pure Black) -->
    <style name="Theme.EssentialSpace.PitchBlack" parent="Theme.EssentialSpace">
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#121212</item>
        <item name="colorSecondaryContainer">#1E1E1E</item>
        <item name="android:windowBackground">#000000</item>

        <item name="android:textColorPrimary">@color/m3_dark_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_dark_on_surface_variant</item>
        <item name="android:textColorTertiary">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Frosted Glass Theme (Wallpaper Transparency) -->
    <style name="Theme.EssentialSpace.Glass" parent="Theme.EssentialSpace">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:colorBackground">#99000000</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="colorSurface">#D1161920</item>
        <item name="colorSurfaceVariant">#E012141A</item>
        <item name="colorSecondaryContainer">#E620242E</item>

        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#E6E6E6</item>
        <item name="android:textColorTertiary">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- App Starting Splash Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_custom_void</item>
        <item name="postSplashScreenTheme">@style/Theme.EssentialSpace</item>
    </style>

    <!-- Floating Dialog Base Style -->
    <style name="ThemedDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/BouncyDialogAnimation</item>
    </style>

    <!-- Specific Floating Dialog Themes -->
    <style name="ThemedDialog.Light" parent="Theme.EssentialSpace">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/BouncyDialogAnimation</item>
    </style>

    <style name="ThemedDialog.PitchBlack" parent="Theme.EssentialSpace.PitchBlack">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowAnimationStyle">@style/BouncyDialogAnimation</item>
    </style>

    <style name="ThemedDialog.Glass" parent="Theme.EssentialSpace.Glass">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowAnimationStyle">@style/BouncyDialogAnimation</item>
    </style>

    <style name="BouncyDialogAnimation">
        <item name="android:windowEnterAnimation">@anim/pop_enter</item>
        <item name="android:windowExitAnimation">@anim/pop_exit</item>
    </style>

    <style name="Theme.EssentialSpace.FullscreenMenu" parent="Theme.EssentialSpace">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.EssentialSpace.PitchBlack.FullscreenMenu" parent="Theme.EssentialSpace.PitchBlack">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="Theme.EssentialSpace.Glass.FullscreenMenu" parent="Theme.EssentialSpace.Glass">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorSurface">#E6121418</item>
    </style>

    <style name="SideBarAnimationLeft">
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <style name="IosModalAnimation">
        <item name="android:windowEnterAnimation">@anim/ios_slide_up_enter</item>
        <item name="android:windowExitAnimation">@anim/ios_slide_down_exit</item>
    </style>

    <style name="IosZoomAnimation">
        <item name="android:windowEnterAnimation">@anim/ios_zoom_enter</item>
        <item name="android:windowExitAnimation">@anim/ios_zoom_exit</item>
    </style>

</resources>